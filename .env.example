# RecPro — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Database ─────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/recruitment_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_PASSWORD=your_db_password

# ── JWT ──────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
APP_JWT_SECRET=REPLACE_WITH_32_CHAR_MIN_RANDOM_SECRET
APP_JWT_EXPIRATION_MS=86400000

# ── CORS ─────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── File upload ───────────────────────────────────────
APP_UPLOAD_DIR=./uploads

# ── Email (Gmail App Password) ────────────────────────
SPRING_MAIL_USERNAME=your-gmail@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password

# ── Hyperspace AI (SAP internal LLM) ─────────────────
HYPERSPACE_API_KEY=your-hyperspace-api-key
HYPERSPACE_BASE_URL=http://localhost:6655/openai/v1
HYPERSPACE_MODEL=gpt-4.1-mini
