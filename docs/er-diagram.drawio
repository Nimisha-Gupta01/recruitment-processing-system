    <!-- 8. APPLICATIONS ──► NOTIFICATIONS (dashed — triggers email on status change, no FK)
         Routes below all 3 bottom tables to avoid crossing INTERVIEWS -->
    <mxCell id="rel_an" style="endArrow=open;endSize=8;dashed=1;dashPattern=8 4;exitX=0.5;exitY=1;exitFixed=1;entryX=0.5;entryY=1;entryFixed=1;html=1;strokeWidth=1.5;strokeColor=#666666;edgeStyle=orthogonalEdgeStyle;" edge="1" source="app" target="ntf" parent="1">
